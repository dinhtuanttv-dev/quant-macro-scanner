generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MacroNewsRecord {
  id              String   @id @default(cuid())
  headline        String
  summary         String?
  url             String
  type            String
  scope           String
  sourceId        String
  sourceName      String
  rawImpact       Float
  severity        String
  affectedSectors String[]
  relatedTickers  String[]
  contentHash     String   @unique
  publishedAt     DateTime
  fetchedAt       DateTime @default(now())

  @@index([scope])
  @@index([severity])
  @@index([publishedAt])
  @@index([sourceId])
}

enum CatalystCategory {
  earnings
  ma
  regulatory
  rating
  contract
  insider
  macro
}

enum CatalystCredibility {
  confirmed
  rumor
}

enum PropagationDistance {
  direct
  upstream
  downstream
  competitor
  commodity
}

enum ImpactDirection {
  benefit
  harm
}

enum TargetType {
  sector
  ticker
}

enum Horizon {
  short
  medium
  long
}

model CatalystSource {
  id                 String              @id @default(cuid())
  title              String
  category           CatalystCategory
  sourceCredibility  CatalystCredibility
  publishedDate      DateTime
  executionDate      DateTime?
  firstDetectedAt    DateTime            @default(now())
  corroborationCount Int                 @default(1)
  originRecordId     String?             @unique
  sourceUrl          String?
  targetPrice        Float?
  sourceRefs         SourceReference[]
  edges              ImpactEdge[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([firstDetectedAt])
  @@index([category])
}

model SourceReference {
  id           String          @id @default(cuid())
  sourceId     String
  source       CatalystSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceName   String
  sourceUrl    String
  discoveredAt DateTime        @default(now())

  @@index([sourceId])
}

model ImpactEdge {
  id                  String              @id @default(cuid())
  sourceId            String
  source              CatalystSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  targetType          TargetType
  targetId            String
  direction           ImpactDirection
  propagationDistance PropagationDistance
  hopCount            Int                 @default(1)
  baseWeight          Float
  decayRate           Float
  horizon             Horizon
  createdAt           DateTime            @default(now())

  @@index([targetType, targetId])
  @@index([sourceId])
}

// P2 (Bo Loc Co Phieu toan thi truong): luu ket qua quet nen (Cron Job)
// cho universe VN30+VN100 (100 ma, xac nhan qua /api/universe). CHỈ luu
// ma DA CO su kien co tuc (loc so bo o tang Cron), khong luu ca 100 ma
// neu khong co su kien gi - tranh lang phi tinh toan Dividend Quality
// Score cho ma khong lien quan.
model DividendUniverseEntry {
  ticker              String    @id
  sector              String?
  name                String?

  // Dividend Quality Score 4 tang (giong cong thuc da dung cho 17 ma)
  tier1               Float?
  tier2               Float?
  tier3               Float?
  overallScoreTier123  Float?   // Chi Tang 1-3 (Tang 4 RS+RedFlag tinh o frontend, giong 17 ma)

  // Su kien co tuc GAN NHAT (da sap xep dung uu tien: sap toi truoc,
  // qua khu gan day sau - dung logic sortEventsByRelevance)
  latestEventType     String?   // CASH | STOCK_DIVIDEND | BONUS_ISSUE | ESOP
  latestEventTitle    String?
  publicDate          DateTime?
  agmDate             DateTime?
  exrightDate         DateTime?
  recordDate          DateTime?
  settlementDate      DateTime?
  valuePerShare       Float?
  exerciseRatio       Float?

  // Fundamentals (dung cho bo loc Yield/ROE/PE/Debt/RSI)
  price               Float?
  pe                  Float?
  roe                 Float?
  debtEquity          Float?
  rsi14               Float?
  dividendYieldPct    Float?
  payoutRatioPct      Float?  // DPS/EPS - da tinh noi bo Cron Job 2, bo sung luu rieng de dong bo voi 17 ma
  profitGrowthYoY     Float?  // % tang truong LNST YoY - da tinh noi bo, bo sung luu rieng
  fScore              Int?    // F-Score rut gon 6/9 tieu chi (Piotroski, thieu CFO + So CP luu hanh)

  lastScannedAt       DateTime  @default(now()) @updatedAt

  @@index([sector])
  @@index([exrightDate])
}

// P2 (AI Nhom B) - bang DUNG CHUNG cho CA 17 ma theo doi goc VA Universe
// (khac voi DividendUniverseEntry chi danh cho Universe). Luu KET QUA
// AI (Gemini) cho Pros/Cons + Catalyst Score - CHI 2 truong nay, vi CAC
// truong khac (insider/macro/global/news/agmAgenda) THIEU NGUON TIN THAT
// de AI dua vao, se BIA neu co ep sinh - da quyet dinh BO HAN, khong
// dua AI sinh noi dung khong co can cu.
model DividendAiAnalysis {
  ticker        String   @id
  pros          String[]
  cons          String[]
  catalystScore Int?     // 1-10, uoc luong dua tren Dividend Quality Score da co
  generatedAt   DateTime @default(now()) @updatedAt
}

// Timing Engine (P3) - moi dong = 1 SU KIEN CO TUC LICH SU cua 1 ma, voi
// % loi nhuan da tinh san cho 5 cua so chuan (xem lib/cotuc/dividend-
// cycle-engine.ts). Cron Job quet TOAN BO lich su (5 nam) cho 88 ma,
// bootstrap/xep hang tinh REAL-TIME o route doc (nhanh, du lieu da co).
model DividendCycleWindow {
  id            String   @id @default(cuid())
  ticker        String
  exDate        DateTime
  divType       String   // CASH | STOCK_DIVIDEND | BONUS_ISSUE | ESOP
  wM1           Float?
  wPreAgm       Float?
  wPreEx        Float?
  wPostEx       Float?
  wPostCredit   Float?
  computedAt    DateTime @default(now()) @updatedAt

  @@unique([ticker, exDate])
  @@index([ticker])
}