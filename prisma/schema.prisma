generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MacroNewsRecord {
  id              String   @id @default(cuid())
  headline        String
  summary         String?
  url             String
  type            String
  scope           String
  sourceId        String
  sourceName      String
  rawImpact       Float
  severity        String
  affectedSectors String[]
  relatedTickers  String[]
  contentHash     String   @unique
  publishedAt     DateTime
  fetchedAt       DateTime @default(now())

  @@index([scope])
  @@index([severity])
  @@index([publishedAt])
  @@index([sourceId])
}

enum CatalystCategory {
  earnings
  ma
  regulatory
  rating
  contract
  insider
  macro
}

enum CatalystCredibility {
  confirmed
  rumor
}

enum PropagationDistance {
  direct
  upstream
  downstream
  competitor
  commodity
}

enum ImpactDirection {
  benefit
  harm
}

enum TargetType {
  sector
  ticker
}

enum Horizon {
  short
  medium
  long
}

model CatalystSource {
  id                 String              @id @default(cuid())
  title              String
  category           CatalystCategory
  sourceCredibility  CatalystCredibility
  publishedDate      DateTime
  executionDate      DateTime?
  firstDetectedAt    DateTime            @default(now())
  corroborationCount Int                 @default(1)
  originRecordId     String?             @unique
  sourceUrl          String?
  targetPrice        Float?
  sourceRefs         SourceReference[]
  edges              ImpactEdge[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([firstDetectedAt])
  @@index([category])
}

model SourceReference {
  id           String          @id @default(cuid())
  sourceId     String
  source       CatalystSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceName   String
  sourceUrl    String
  discoveredAt DateTime        @default(now())

  @@index([sourceId])
}

model ImpactEdge {
  id                  String              @id @default(cuid())
  sourceId            String
  source              CatalystSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  targetType          TargetType
  targetId            String
  direction           ImpactDirection
  propagationDistance PropagationDistance
  hopCount            Int                 @default(1)
  baseWeight          Float
  decayRate           Float
  horizon             Horizon
  createdAt           DateTime            @default(now())

  @@index([targetType, targetId])
  @@index([sourceId])
}

// P2 (Bo Loc Co Phieu toan thi truong): luu ket qua quet nen (Cron Job)
// cho universe VN30+VN100 (100 ma, xac nhan qua /api/universe). CHỈ luu
// ma DA CO su kien co tuc (loc so bo o tang Cron), khong luu ca 100 ma
// neu khong co su kien gi - tranh lang phi tinh toan Dividend Quality
// Score cho ma khong lien quan.
model DividendUniverseEntry {
  ticker              String    @id
  sector              String?
  name                String?

  // Dividend Quality Score 4 tang (giong cong thuc da dung cho 17 ma)
  tier1               Float?
  tier2               Float?
  tier3               Float?
  overallScoreTier123  Float?   // Chi Tang 1-3 (Tang 4 RS+RedFlag tinh o frontend, giong 17 ma)

  // Su kien co tuc GAN NHAT (da sap xep dung uu tien: sap toi truoc,
  // qua khu gan day sau - dung logic sortEventsByRelevance)
  latestEventType     String?   // CASH | STOCK_DIVIDEND | BONUS_ISSUE | ESOP
  latestEventTitle    String?
  publicDate          DateTime?
  agmDate             DateTime?
  exrightDate         DateTime?
  recordDate          DateTime?
  settlementDate      DateTime?
  valuePerShare       Float?
  exerciseRatio       Float?

  // Fundamentals (dung cho bo loc Yield/ROE/PE/Debt/RSI)
  price               Float?
  pe                  Float?
  roe                 Float?
  debtEquity          Float?
  rsi14               Float?
  dividendYieldPct    Float?
  payoutRatioPct      Float?  // DPS/EPS - da tinh noi bo Cron Job 2, bo sung luu rieng de dong bo voi 17 ma
  profitGrowthYoY     Float?  // % tang truong LNST YoY - da tinh noi bo, bo sung luu rieng
  fScore              Int?    // F-Score rut gon 6/9 tieu chi (Piotroski, thieu CFO + So CP luu hanh)

  lastScannedAt       DateTime  @default(now()) @updatedAt

  @@index([sector])
  @@index([exrightDate])
}

// P2 (AI Nhom B) - bang DUNG CHUNG cho CA 17 ma theo doi goc VA Universe
// (khac voi DividendUniverseEntry chi danh cho Universe). Luu KET QUA
// AI (Gemini) cho Pros/Cons + Catalyst Score - CHI 2 truong nay, vi CAC
// truong khac (insider/macro/global/news/agmAgenda) THIEU NGUON TIN THAT
// de AI dua vao, se BIA neu co ep sinh - da quyet dinh BO HAN, khong
// dua AI sinh noi dung khong co can cu.
model DividendAiAnalysis {
  ticker        String   @id
  pros          String[]
  cons          String[]
  catalystScore Int?     // 1-10, uoc luong dua tren Dividend Quality Score da co
  generatedAt   DateTime @default(now()) @updatedAt
}

// Timing Engine (P3) - moi dong = 1 SU KIEN CO TUC LICH SU cua 1 ma, voi
// % loi nhuan da tinh san cho 5 cua so chuan (xem lib/cotuc/dividend-
// cycle-engine.ts). Cron Job quet TOAN BO lich su (5 nam) cho 88 ma,
// bootstrap/xep hang tinh REAL-TIME o route doc (nhanh, du lieu da co).
model DividendCycleWindow {
  id            String   @id @default(cuid())
  ticker        String
  exDate        DateTime
  divType       String   // CASH | STOCK_DIVIDEND | BONUS_ISSUE | ESOP
  wM1           Float?
  wPreAgm       Float?
  wPreEx        Float?
  wPostEx       Float?
  wPostCredit   Float?
  computedAt    DateTime @default(now()) @updatedAt

  @@unique([ticker, exDate])
  @@index([ticker])
}

// Elite 10 - Vung 2.5 Time Engine, template AGM (Dai Hoi Dong Co Dong).
// Tuong tu DividendCycleWindow nhung 2 cua so (A1/A2), ngay su kien la
// ngay hop DHCD THAT (eventCode AGME/AGMR/EGME tu VCI).
model AgmCycleWindow {
  id          String   @id @default(cuid())
  ticker      String
  agmDate     DateTime
  wA1         Float?
  wA2         Float?
  computedAt  DateTime @default(now()) @updatedAt

  @@unique([ticker, agmDate])
  @@index([ticker])
}

// SIEU QUET AI - port tu SieuQuetAI_v2_0_full_package (Confluence
// Engine + Scoring da vas loi), nuoi bang du lieu THAT (Yahoo OHLCV +
// VCI FA) thay cho market_sim.py (random-walk gia lap trong ban goc).
//
// 1 dong duy nhat - trang thai VN-INDEX THAT (VNDirect dchart, da xac
// nhan hoat dong tot, dung boi nhieu route khac trong du an).
model SieuQuetIndexState {
  id                String   @id @default("singleton")
  asOf              DateTime
  ma20              Float
  ma50              Float
  ma200             Float
  maAlignmentScore  Float
  trendBias         String   // uptrend | accumulation | distribution | defensive | downtrend
  trendLabel        String
  rsi14             Float
  macdHistogram     Float
  marketBreadthPct  Float
  divergence        String   // none | bullish | bearish
  atr14             Float
  atrPercentile     Float
  breakoutProbability Float
  impulseScore      Float
  narrative         String
  updatedAt         DateTime @updatedAt
}

model SieuQuetStockItem {
  ticker              String   @id
  companyName         String?
  sector              String?
  price               Float?
  changePct           Float?

  faScore             Float?
  taScore             Float?
  eventImpactScore    Float?
  smartScore          Float?

  rsRating            Float?
  riskAdjustedMomentum Float?
  riskRewardRatio     Float?

  trendTag            String?  // Up-Trend | Down-Trend | Accumulation | Distribution
  qualityTag          String?  // Low Debt | High Margin | Core Cash Flow

  confluenceStatusCode  String?
  confluenceStatusLabel String?
  confluenceBoost       Float?
  confluenceReasonCodes String[]
  breakoutBoostBadge    Boolean @default(false)

  // B.6 Foreign Flow (DON GIAN HOA - trung thuc voi du lieu that co san):
  // TRUE neu ma nam trong Top 5 duoc khoi ngoai mua rong manh nhat hom
  // do (tu ban tin chinh thuc HOSE, bang hose_foreign_net_buy da co san
  // trong du an). KHONG PHAI percentile lien tuc nhu ban goc (khong co
  // du lieu de tinh), va CHI co tin hieu "mua", KHONG co "ban" (HOSE
  // khong cong bo danh sach ban rong tuong ung).
  foreignNetBuyFlag     Boolean @default(false)

  piotroskiFScore     Int?     // RUT GON 6/9 (dung lai calculateFScoreLite da lam cho Tab
                                // Co Tuc - VAN THIEU CFO/So CP luu hanh, KHONG bia them)
  fScoreMax           Int      @default(6)
  // Altman Z-Score: BO KHOI PHIEN BAN NAY - can retainedEarnings, ebit,
  // marketCap (can So CP luu hanh) - CHUA CO NGUON nao xac nhan duoc
  // (giong ly do F-Score chi lam 6/9). Se bo sung neu tim duoc nguon sau.

  computedAt          DateTime @default(now()) @updatedAt

  @@index([smartScore])
}

// SIEU QUET AI - GIAI DOAN 3: Multi-AI Consensus (Event System). PORT
// pipeline logic tu events.py (cap/rate-limit/exit condition/idempotency
// - co gia tri that), THAY 3 AI gia (_simulate_ai_vote) bang 1 Gemini
// THAT (co Google Search Grounding qua module gemini-monitor da co san
// trong du an). Do CHI CO 1 AI provider (khac "Multi-AI" 2-3 provider
// doc lap cua ban goc), NGUOI DUNG la ben "doi chung" cuoi cung qua
// Modal xac nhan (dung tinh than "Doi Chung + Xac Nhan Nguoi Dung" cua
// ten goi thiet ke goc).
model SieuQuetEvent {
  id                    String   @id @default(cuid())
  title                 String
  category              String   // monetary_policy | geopolitical | earnings | upgrade | other
  source                String   // ai_discovery | manual_input
  enteredBy             String   @default("default_user")
  severity              Int      @default(3) // 1-5
  description           String
  expectedDurationDays  Int?
  sectors               String[]
  tickers               String[] @default([])
  magnitude             String   @default("medium") // high | medium | low - can cho computeEventImpactScore
  direction             String   @default("positive") // positive | negative
  sourceUrl             String?
  sourceName            String?
  verifiedStatus        String   @default("user_confirmed") // CHI gia tri nay moi duoc dua vao eventImpactScore
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([verifiedStatus])
}

// Candidate cho DISCOVERY (Gemini + Google Search Grounding, 3 lan/ngay:
// 8h/13h/20h gio VN) - CHO DEN KHI nguoi dung Xac nhan/Bo qua.
model SieuQuetEventCandidate {
  id              String   @id @default(cuid())
  rawTitle        String
  category        String
  sectors         String[]
  magnitude       String   @default("medium") // high | medium | low
  direction       String   @default("positive") // positive | negative
  sourceUrl       String?  // BAT BUOC phai co URL that tu Grounding, neu khong co -> khong tao candidate (chong ao giac)
  sourceName      String?
  announcementDate String?
  aiSummary       String   // Gemini tom tat NGAN vi sao day la su kien dang chu y
  discoveredAt    DateTime @default(now())
  decision        String?  // null (dang cho) | confirmed | skipped
  decidedAt       DateTime?

  @@index([decision])
}

// Rate-limit/skip-streak/cooldown/idempotency state - PHAI luu Database
// (khac ban goc dung Python dict in-memory) vi Vercel serverless KHONG
// giu state giua cac request (moi request co the chay instance khac).
model SieuQuetRateState {
  userId          String   @id @default("default_user")
  skipStreak      Int      @default(0)
  cooldownUntil   DateTime?
  skipTimestamps  DateTime[] @default([]) // cac lan skip trong gio gan nhat (loc >1h khi doc)
  lastIdempotencyKeys String[] @default([]) // 20 key gan nhat, chong double-submit
  updatedAt       DateTime @updatedAt
}

// TOP 200 UNIVERSE - danh sach ma xep hang theo Score = 0.4*norm(MarketCap)
// + 0.6*norm(Volume30D), lay tu TradingView Scanner API (cong khai, khong
// chinh thuc). Cap nhat boi Cron Job rieng (tan suat thap hon Cron Job
// tinh diem chinh, vi thanh phan Top 200 it doi hang ngay).
model SieuQuetUniverseTicker {
  ticker        String   @id
  name          String?
  exchange      String?
  sector        String?
  marketCap     Float?
  volume        Float?
  score         Float
  rank          Int
  updatedAt     DateTime @updatedAt

  @@index([rank])
}

// Elite 10 - Vung 1-6 "Giai Trinh Hoi Tu v2" (Confluence Engine, package
// global-quanta-confluence). Port tu SQLAlchemy (SQLite) sang Prisma
// (Postgres). Thay "Event Bus in-memory pub/sub" (khong tuong thich
// Vercel serverless - moi request la 1 instance moi, khong giu state)
// bang bang "ConfluenceSignalCache": moi tru cot (6 tab) GHI tin hieu
// moi nhat cua minh vao day (qua Cron Job/route da co cua tab do),
// SnapshotWindow logic DOC LAI tu bang nay thay vi Event Bus in-memory.
model ConfluenceSignalCache {
  ticker         String
  pillar         String   // ta | core | sector | catalyst | macro | dividend
  signalValue    Float
  rollingMean90d Float    @default(50)
  rollingStd90d  Float    @default(10)
  raw            Json     @default("{}")
  updatedAt      DateTime @default(now()) @updatedAt

  @@id([ticker, pillar])
  @@index([ticker])
}

model ConfluenceAuditLog {
  id               Int      @id @default(autoincrement())
  ticker           String
  profileId        String   @default("default")
  regime           String
  weightsEffective Json
  nAvailable       Int
  penaltyTotal     Float
  penaltyBreakdown Json
  score            Float
  ciLow            Float
  ciHigh           Float
  starRating       Int
  riskFlags        Json
  createdAt        DateTime @default(now())

  @@index([ticker])
}

model ConfluenceScoreHistory {
  id        Int      @id @default(autoincrement())
  ticker    String
  score     Float
  createdAt DateTime @default(now())

  @@index([ticker])
}